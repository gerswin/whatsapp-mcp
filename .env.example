# Origen público https (necesario para OAuth con Claude.ai y ChatGPT).
PUBLIC_URL=https://wa.example.com

# Dónde escucha en el host. Con un túnel en la misma máquina basta 127.0.0.1.
BIND_ADDR=127.0.0.1
PORT=4020
TZ=UTC

# Borrar mensajes guardados con más de N días (0 = conservar siempre).
RETENTION_DAYS=0

# true: guarda los estados de tus contactos como un chat aparte ("Status updates").
STORE_STATUS=false

# Transcripción de audios (opcional). Cualquier API compatible con OpenAI sirve.
# Los audios se envían a ese servicio para transcribirlos.
WHISPER_API_KEY=
# WHISPER_BASE_URL=https://api.openai.com/v1
# WHISPER_MODEL=whisper-1
# WHISPER_LANGUAGE=es
# true: transcribe cada audio al llegar (aparece en el historial y en la búsqueda).
# false: solo cuando el asistente lo pide con get_media.
WHISPER_AUTO=true
# Audios más largos que esto no se transcriben automáticamente.
WHISPER_MAX_SECONDS=600
